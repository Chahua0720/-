    ];

    const STORAGE_KEY = "hz-flower-guide-markers-v1";

    const mapShell = document.getElementById("mapShell");
    const mapStage = document.getElementById("mapStage");
    const mapImg = document.getElementById("mapImg");
    const markerLayer = document.getElementById("markerLayer");
    const markerList = document.getElementById("markerList");
    const emptyTip = document.getElementById("emptyTip");

    const addModeBtn = document.getElementById("addModeBtn");
    const modeBadge = document.getElementById("modeBadge");
    const resetBtn = document.getElementById("resetBtn");
    const zoomInBtn = document.getElementById("zoomInBtn");
    const zoomOutBtn = document.getElementById("zoomOutBtn");
    const fitBtn = document.getElementById("fitBtn");

    const titleInput = document.getElementById("titleInput");
    const descInput = document.getElementById("descInput");
    const detailInput = document.getElementById("detailInput");
    const iconPreview = document.getElementById("iconPreview");
    const uploadBtn = document.getElementById("uploadBtn");
    const iconInput = document.getElementById("iconInput");

    const detailImagePreview = document.getElementById("detailImagePreview");
    const uploadDetailImageBtn = document.getElementById("uploadDetailImageBtn");
    const detailImageInput = document.getElementById("detailImageInput");

    const saveBtn = document.getElementById("saveBtn");
    const deleteBtn = document.getElementById("deleteBtn");

    const popover = document.getElementById("popover");
    const popTitle = document.getElementById("popTitle");
    const popDesc = document.getElementById("popDesc");
    const popIcon = document.getElementById("popIcon");
    const openDetailBtn = document.getElementById("openDetailBtn");

    const exportBtn = document.getElementById("exportBtn");
    const importBtn = document.getElementById("importBtn");
    const importInput = document.getElementById("importInput");
    const restoreBtn = document.getElementById("restoreBtn");
    const clearBtn = document.getElementById("clearBtn");

    const cropModal = document.getElementById("cropModal");
    const closeCropBtn = document.getElementById("closeCropBtn");
    const confirmCropBtn = document.getElementById("confirmCropBtn");
    const centerCropBtn = document.getElementById("centerCropBtn");
    const cropCanvas = document.getElementById("cropCanvas");
    const cropCtx = cropCanvas.getContext("2d");
    const zoomRange = document.getElementById("zoomRange");

    const detailModal = document.getElementById("detailModal");
    const closeDetailBtn = document.getElementById("closeDetailBtn");
    const detailModalImage = document.getElementById("detailModalImage");
    const detailModalTitle = document.getElementById("detailModalTitle");
    const detailModalDesc = document.getElementById("detailModalDesc");

    let markers = [];
    let selectedId = null;
    let addMode = false;
    let pendingIcon = null;
    let pendingDetailImage = null;

    const view = {
      scale: 0.8,
      min: 0.32,
      max: 3,
      x: 0,
      y: 0,
      dragging: false,
      startX: 0,
      startY: 0,
      moved: false
    };

    const crop = {
      img: null,
      scale: 1,
      x: 0,
      y: 0,
      dragging: false,
      startX: 0,
      startY: 0
    };

    function uid() {
      return "f_" + Math.random().toString(36).slice(2, 10) + "_" + Date.now().toString(36);
    }

    function cloneDefaultMarkers() {
      return JSON.parse(JSON.stringify(DEFAULT_MARKERS));
    }

    function html(str) {
      return String(str || "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    function normalizeMarker(item) {
      return {
        id: item.id || uid(),
        x: Number(item.x) || 0,
        y: Number(item.y) || 0,
        title: item.title || "未命名花点",
        desc: item.desc || "",
        detail: item.detail || item.desc || "暂无详细介绍",
        icon: item.icon || DEFAULT_ICON,
        detailImage: item.detailImage || DEFAULT_DETAIL_IMAGE
      };
    }

    function saveLocal() {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(markers));
    }

    function loadLocalOrDefault() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) {
          const data = JSON.parse(raw);
          markers = Array.isArray(data) ? data.map(normalizeMarker) : cloneDefaultMarkers();
        } else {
          markers = cloneDefaultMarkers();
          saveLocal();
        }
      } catch {
        markers = cloneDefaultMarkers();
        saveLocal();
      }
    }

    function applyView() {
      mapStage.style.transform = `translate(${view.x}px, ${view.y}px) scale(${view.scale})`;
    }

    function fitView() {
      const w = mapShell.clientWidth;
      const h = mapShell.clientHeight;
      const iw = mapImg.naturalWidth || 1200;
      const ih = mapImg.naturalHeight || 800;
      const s = Math.min(w / iw, h / ih) * 0.94;

      view.scale = Math.max(view.min, Math.min(s, 1.3));
      view.x = -iw * view.scale / 2;
      view.y = -ih * view.scale / 2;
      applyView();
      hidePopover();
    }

    function updateMode() {
      modeBadge.textContent = "模式：" + (addMode ? "添加花点" : "浏览");
      addModeBtn.textContent = addMode ? "退出添加花点" : "开启添加花点";
      addModeBtn.classList.toggle("primary", addMode);
    }

    function screenToMap(clientX, clientY) {
      const rect = mapShell.getBoundingClientRect();
      const px = clientX - rect.left - mapShell.clientWidth / 2;
      const py = clientY - rect.top - mapShell.clientHeight / 2;

      return {
        x: (px - view.x) / view.scale,
        y: (py - view.y) / view.scale
      };
    }

    function zoomAt(clientX, clientY, factor) {
      const old = view.scale;
      const next = Math.max(view.min, Math.min(view.max, old * factor));
      if (next === old) return;

      const rect = mapShell.getBoundingClientRect();
      const px = clientX - rect.left - mapShell.clientWidth / 2;
      const py = clientY - rect.top - mapShell.clientHeight / 2;

      const mx = (px - view.x) / old;
      const my = (py - view.y) / old;

      view.scale = next;
      view.x = px - mx * next;
      view.y = py - my * next;

      applyView();
      hidePopover();
    }

    function flyToMarker(marker) {
      if (!marker) return;

      const startX = view.x;
      const startY = view.y;
      const startS = view.scale;

      const targetS = Math.max(view.min, Math.min(view.max, 1.05));
      const targetX = -marker.x * targetS;
      const targetY = -marker.y * targetS;

      const duration = 680;
      const start = performance.now();

      function ease(t) {
        return 1 - Math.pow(1 - t, 4);
      }

      function step(now) {
        const p = Math.min(1, (now - start) / duration);
        const e = ease(p);

        view.scale = startS + (targetS - startS) * e;
        view.x = startX + (targetX - startX) * e;
        view.y = startY + (targetY - startY) * e;
        applyView();

        if (p < 1) {
          requestAnimationFrame(step);
        } else {
          const el = document.querySelector(`.marker[data-id="${marker.id}"]`);
          if (el) showPopover(marker, el);
        }
      }

      hidePopover();
      requestAnimationFrame(step);
    }

    function renderMarkers() {
      markerLayer.innerHTML = "";
      markerList.innerHTML = "";
      emptyTip.style.display = markers.length ? "none" : "block";

      markers.forEach(marker => {
        const el = document.createElement("div");
        el.className = "marker" + (marker.id === selectedId ? " active" : "");
        el.dataset.id = marker.id;
        el.style.left = marker.x + "px";
        el.style.top = marker.y + "px";
        el.innerHTML = `
          <div class="marker-icon">
            <img src="${marker.icon || DEFAULT_ICON}" alt="">
          </div>
          <div class="marker-dot"></div>
          <div class="marker-label">${html(marker.title || "未命名花点")}</div>
        `;

        el.addEventListener("click", e => {
          e.stopPropagation();
          selectMarker(marker.id);
          showPopover(marker, el);
        });

        markerLayer.appendChild(el);

        const item = document.createElement("div");
        item.className = "marker-item" + (marker.id === selectedId ? " active" : "");
        item.innerHTML = `
          <img class="list-icon" src="${marker.icon || DEFAULT_ICON}" alt="">
          <div class="list-meta">
            <div class="list-title">${html(marker.title || "未命名花点")}</div>
            <div class="list-desc">${html(marker.desc || "暂无说明")}</div>
          </div>
        `;

        item.addEventListener("click", () => {
          selectMarker(marker.id);
          flyToMarker(marker);
        });

        markerList.appendChild(item);
      });
    }

    function selectMarker(id) {
      selectedId = id;
      pendingIcon = null;
      pendingDetailImage = null;

      const marker = markers.find(m => m.id === id);
      if (marker) {
        titleInput.value = marker.title || "";
        descInput.value = marker.desc || "";
        detailInput.value = marker.detail || "";
        iconPreview.src = marker.icon || DEFAULT_ICON;
        detailImagePreview.src = marker.detailImage || DEFAULT_DETAIL_IMAGE;
      } else {
        titleInput.value = "";
        descInput.value = "";
        detailInput.value = "";
        iconPreview.src = DEFAULT_ICON;
        detailImagePreview.src = DEFAULT_DETAIL_IMAGE;
      }

      renderMarkers();
    }

    function clearSelection() {
      selectedId = null;
      pendingIcon = null;
      pendingDetailImage = null;
      titleInput.value = "";
      descInput.value = "";
      detailInput.value = "";
      iconPreview.src = DEFAULT_ICON;
      detailImagePreview.src = DEFAULT_DETAIL_IMAGE;
      hidePopover();
      renderMarkers();
    }

    function addMarker(clientX, clientY) {
      const p = screenToMap(clientX, clientY);
      const marker = {
        id: uid(),
        x: p.x,
        y: p.y,
        title: "新花点",
        desc: "请编辑该花点简短说明",
        detail: "这里可以填写花卉名称、观赏季节、位置说明、拍照建议和相关介绍。",
        icon: DEFAULT_ICON,
        detailImage: DEFAULT_DETAIL_IMAGE
      };

      markers.push(marker);
      saveLocal();
      selectMarker(marker.id);
      renderMarkers();

      requestAnimationFrame(() => {
        const el = document.querySelector(`.marker[data-id="${marker.id}"]`);
        if (el) showPopover(marker, el);
      });
    }

    function saveMarker() {
      const marker = markers.find(m => m.id === selectedId);
      if (!marker) {
        alert("请先选择一个花点");
        return;
      }

      marker.title = titleInput.value.trim() || "未命名花点";
      marker.desc = descInput.value.trim() || "";
      marker.detail = detailInput.value.trim() || marker.desc || "暂无详细介绍";

      if (pendingIcon) {
        marker.icon = pendingIcon;
        pendingIcon = null;
      }

      if (pendingDetailImage) {
        marker.detailImage = pendingDetailImage;
        pendingDetailImage = null;
      }

      saveLocal();
      renderMarkers();

      const el = document.querySelector(`.marker[data-id="${marker.id}"]`);
      if (el) showPopover(marker, el);
    }

    function deleteMarker() {
      if (!selectedId) {
        alert("请先选择要删除的花点");
        return;
      }

      if (!confirm("确认删除该花点吗？")) return;

      markers = markers.filter(m => m.id !== selectedId);
      saveLocal();
      clearSelection();
    }

    function showPopover(marker, el) {
      popTitle.textContent = marker.title || "未命名花点";
      popDesc.textContent = marker.desc || "暂无说明";
      popIcon.src = marker.icon || DEFAULT_ICON;
      openDetailBtn.dataset.id = marker.id;

      popover.classList.remove("show");
      void popover.offsetWidth;
      popover.classList.add("show");

      requestAnimationFrame(() => {
        const shellRect = mapShell.getBoundingClientRect();
        const markerRect = el.getBoundingClientRect();

        const pw = popover.offsetWidth;
        const ph = popover.offsetHeight;

        let left = markerRect.left - shellRect.left + markerRect.width / 2 - pw / 2;
        let top = markerRect.top - shellRect.top - ph - 18;

        if (left < 14) left = 14;
        if (left + pw > shellRect.width - 14) left = shellRect.width - pw - 14;
        if (top < 78) top = markerRect.bottom - shellRect.top + 14;

        popover.style.left = left + "px";
        popover.style.top = top + "px";
      });
    }

    function hidePopover() {
      popover.classList.remove("show");
    }

    function openDetailModal(marker) {
      if (!marker) return;

      detailModalTitle.textContent = marker.title || "未命名花点";
      detailModalDesc.textContent = marker.detail || marker.desc || "暂无详细介绍";
      detailModalImage.src = marker.detailImage || DEFAULT_DETAIL_IMAGE;

      detailModal.classList.add("show");
    }

    function closeDetailModal() {
      detailModal.classList.remove("show");
    }

    function exportMarkers() {
      const blob = new Blob([JSON.stringify(markers, null, 2)], {
        type: "application/json"
      });

      const a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = "hz-flower-guide-markers.json";
      a.click();
      URL.revokeObjectURL(a.href);
    }

    function importMarkers(file) {
      const reader = new FileReader();

      reader.onload = () => {
        try {
          const data = JSON.parse(reader.result);
          if (!Array.isArray(data)) throw new Error();

          markers = data.map(normalizeMarker);
          saveLocal();
          clearSelection();
          renderMarkers();
          alert("导入成功");
        } catch {
          alert("导入失败，JSON 格式不正确");
        }
      };

      reader.readAsText(file, "utf-8");
    }

    function restoreDefaultMarkers() {
      if (!confirm("确认恢复内置花点？当前本地编辑内容会被覆盖。")) return;
      markers = cloneDefaultMarkers();
      saveLocal();
      clearSelection();
      renderMarkers();
      alert("已恢复内置花点");
    }

    function clearLocalData() {
      if (!confirm("确认清空本地保存数据？清空后会重新载入内置花点。")) return;
      localStorage.removeItem(STORAGE_KEY);
      markers = cloneDefaultMarkers();
      saveLocal();
      clearSelection();
      renderMarkers();
      alert("已清空本地数据，并恢复内置花点");
    }

    function openCrop(dataUrl) {
      crop.img = new Image();

      crop.img.onload = () => {
        centerCropImage();
        cropModal.classList.add("show");
        drawCrop();
      };

      crop.img.src = dataUrl;
    }

    function centerCropImage() {
      if (!crop.img) return;

      const base = Math.max(
        cropCanvas.width / crop.img.width,
        cropCanvas.height / crop.img.height
      );

      crop.scale = base;
      crop.x = (cropCanvas.width - crop.img.width * crop.scale) / 2;
      crop.y = (cropCanvas.height - crop.img.height * crop.scale) / 2;

      zoomRange.value = crop.scale;
      zoomRange.min = Math.max(0.1, base * 0.5);
      zoomRange.max = base * 4;
    }

    function drawCrop() {
      cropCtx.clearRect(0, 0, cropCanvas.width, cropCanvas.height);

      cropCtx.fillStyle = "#f5f5f7";
      cropCtx.fillRect(0, 0, cropCanvas.width, cropCanvas.height);

      if (crop.img) {
        cropCtx.drawImage(
          crop.img,
          crop.x,
          crop.y,
          crop.img.width * crop.scale,
          crop.img.height * crop.scale
        );
      }

      cropCtx.save();
      cropCtx.strokeStyle = "rgba(255,255,255,.95)";
      cropCtx.lineWidth = 3;
      cropCtx.strokeRect(1.5, 1.5, cropCanvas.width - 3, cropCanvas.height - 3);

      cropCtx.strokeStyle = "rgba(0,122,255,.65)";
      cropCtx.lineWidth = 2;
      cropCtx.setLineDash([8, 8]);
      cropCtx.strokeRect(28, 28, cropCanvas.width - 56, cropCanvas.height - 56);
      cropCtx.restore();
    }

    function confirmCrop() {
      if (!crop.img) return;

      const out = document.createElement("canvas");
      out.width = 256;
      out.height = 256;
      const ctx = out.getContext("2d");

      ctx.drawImage(cropCanvas, 0, 0, 256, 256);

      pendingIcon = out.toDataURL("image/png", 0.95);
      iconPreview.src = pendingIcon;
      cropModal.classList.remove("show");
    }

    mapShell.addEventListener("mousedown", e => {
      if (e.button !== 0) return;
      view.dragging = true;
      view.moved = false;
      view.startX = e.clientX - view.x;
      view.startY = e.clientY - view.y;
      mapShell.classList.add("grabbing");
    });

    window.addEventListener("mousemove", e => {
      if (!view.dragging) return;

      const nx = e.clientX - view.startX;
      const ny = e.clientY - view.startY;

      if (Math.abs(nx - view.x) > 2 || Math.abs(ny - view.y) > 2) {
        view.moved = true;
      }

      view.x = nx;
      view.y = ny;
      applyView();
      hidePopover();
    });

    window.addEventListener("mouseup", () => {
      view.dragging = false;
      mapShell.classList.remove("grabbing");
      crop.dragging = false;
    });

    mapShell.addEventListener("wheel", e => {
      e.preventDefault();
      zoomAt(e.clientX, e.clientY, e.deltaY < 0 ? 1.12 : 0.9);
    }, { passive: false });

    mapShell.addEventListener("click", e => {
      if (view.moved) return;
      if (e.target.closest(".marker")) return;

      if (addMode) {
        addMarker(e.clientX, e.clientY);
      } else {
        clearSelection();
      }
    });

    addModeBtn.addEventListener("click", () => {
      addMode = !addMode;
      updateMode();
    });

    resetBtn.addEventListener("click", fitView);
    fitBtn.addEventListener("click", fitView);

    zoomInBtn.addEventListener("click", () => {
      const r = mapShell.getBoundingClientRect();
      zoomAt(r.left + r.width / 2, r.top + r.height / 2, 1.15);
    });

    zoomOutBtn.addEventListener("click", () => {
      const r = mapShell.getBoundingClientRect();
      zoomAt(r.left + r.width / 2, r.top + r.height / 2, 0.87);
    });

    saveBtn.addEventListener("click", saveMarker);
    deleteBtn.addEventListener("click", deleteMarker);

    uploadBtn.addEventListener("click", () => {
      if (!selectedId) {
        alert("请先选择一个花点");
        return;
      }
      iconInput.click();
    });

    iconInput.addEventListener("change", e => {
      const file = e.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = () => openCrop(reader.result);
      reader.readAsDataURL(file);

      e.target.value = "";
    });

    uploadDetailImageBtn.addEventListener("click", () => {
      if (!selectedId) {
        alert("请先选择一个花点");
        return;
      }
      detailImageInput.click();
    });

    detailImageInput.addEventListener("change", e => {
      const file = e.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = () => {
        pendingDetailImage = reader.result;
        detailImagePreview.src = pendingDetailImage;
      };
      reader.readAsDataURL(file);
      e.target.value = "";
    });

    exportBtn.addEventListener("click", exportMarkers);
    importBtn.addEventListener("click", () => importInput.click());
    restoreBtn.addEventListener("click", restoreDefaultMarkers);
    clearBtn.addEventListener("click", clearLocalData);

    importInput.addEventListener("change", e => {
      const file = e.target.files[0];
      if (file) importMarkers(file);
      e.target.value = "";
    });

    openDetailBtn.addEventListener("click", () => {
      const id = openDetailBtn.dataset.id || selectedId;
      const marker = markers.find(m => m.id === id);
      openDetailModal(marker);
    });

    closeDetailBtn.addEventListener("click", closeDetailModal);

    detailModal.addEventListener("click", e => {
      if (e.target === detailModal) closeDetailModal();
    });

    closeCropBtn.addEventListener("click", () => {
      cropModal.classList.remove("show");
    });

    centerCropBtn.addEventListener("click", () => {
      centerCropImage();
      drawCrop();
    });

    confirmCropBtn.addEventListener("click", confirmCrop);

    zoomRange.addEventListener("input", () => {
      if (!crop.img) return;

      const old = crop.scale;
      const next = Number(zoomRange.value);

      const cx = cropCanvas.width / 2;
      const cy = cropCanvas.height / 2;

      const mx = (cx - crop.x) / old;
      const my = (cy - crop.y) / old;

      crop.scale = next;
      crop.x = cx - mx * next;
      crop.y = cy - my * next;

      drawCrop();
    });

    cropCanvas.addEventListener("mousedown", e => {
      crop.dragging = true;
      crop.startX = e.offsetX - crop.x;
      crop.startY = e.offsetY - crop.y;
    });

    cropCanvas.addEventListener("mousemove", e => {
      if (!crop.dragging) return;
      crop.x = e.offsetX - crop.startX;
      crop.y = e.offsetY - crop.startY;
      drawCrop();
    });

    cropCanvas.addEventListener("wheel", e => {
      e.preventDefault();
      if (!crop.img) return;

      const old = crop.scale;
      const factor = e.deltaY < 0 ? 1.08 : 0.92;
      const min = Number(zoomRange.min);
      const max = Number(zoomRange.max);
      const next = Math.max(min, Math.min(max, old * factor));

      const mx = (e.offsetX - crop.x) / old;
      const my = (e.offsetY - crop.y) / old;

      crop.scale = next;
      crop.x = e.offsetX - mx * next;
      crop.y = e.offsetY - my * next;
      zoomRange.value = next;

      drawCrop();
    }, { passive: false });

    window.addEventListener("resize", () => {
      applyView();
      hidePopover();
    });

    document.addEventListener("keydown", e => {
      if (e.key === "Escape") {
        hidePopover();
        cropModal.classList.remove("show");
        closeDetailModal();
      }

      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "s") {
        e.preventDefault();
        saveMarker();
      }
    });

    function init() {
      fitView();
      loadLocalOrDefault();
      renderMarkers();
      iconPreview.src = DEFAULT_ICON;
      detailImagePreview.src = DEFAULT_DETAIL_IMAGE;
      updateMode();
    }

    mapImg.addEventListener("load", init);

    if (mapImg.complete) {
      init();
    }
  </script>
</body>
</html>
