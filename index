<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>河中观花指南</title>

  <style>
    :root {
      --text: #1d1d1f;
      --sub: #6e6e73;
      --blue: #007aff;
      --red: #ff3b30;
      --glass: rgba(255, 255, 255, 0.56);
      --border: rgba(255, 255, 255, 0.68);
      --shadow: 0 24px 72px rgba(0, 0, 0, 0.14);
      --radius: 28px;
    }

    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display",
        "PingFang SC", "Microsoft YaHei", Arial, sans-serif;
      color: var(--text);
      background:
        radial-gradient(circle at 8% 0%, rgba(255,255,255,.96), transparent 32%),
        radial-gradient(circle at 88% 10%, rgba(185,220,255,.64), transparent 30%),
        linear-gradient(135deg, #edf3fa, #dce8f4);
    }

    button,
    input,
    textarea {
      font: inherit;
    }

    button {
      user-select: none;
    }

    .app {
      width: 100%;
      height: 100%;
      padding: 18px;
      display: grid;
      grid-template-columns: 360px 1fr;
      gap: 18px;
    }

    .glass {
      background: var(--glass);
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
      backdrop-filter: blur(24px) saturate(180%);
      -webkit-backdrop-filter: blur(24px) saturate(180%);
    }

    .sidebar {
      border-radius: var(--radius);
      padding: 18px;
      display: flex;
      flex-direction: column;
      gap: 14px;
      overflow: auto;
    }

    .card {
      background: linear-gradient(135deg, rgba(255,255,255,.78), rgba(255,255,255,.43));
      border: 1px solid rgba(255,255,255,.74);
      border-radius: 22px;
      padding: 16px;
    }

    .brand h1 {
      margin: 0;
      font-size: 30px;
      font-weight: 850;
      letter-spacing: -.6px;
    }

    .brand p,
    .hint {
      color: var(--sub);
      font-size: 13px;
      line-height: 1.7;
      margin: 8px 0 0;
    }

    h3 {
      margin: 0 0 14px;
      font-size: 16px;
    }

    .btn-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }

    .btn {
      border: none;
      border-radius: 15px;
      padding: 12px 13px;
      cursor: pointer;
      color: var(--text);
      background: rgba(255,255,255,.8);
      box-shadow: 0 10px 26px rgba(0,0,0,.08);
      font-weight: 760;
      transition: transform .22s ease, box-shadow .22s ease, background .22s ease;
    }

    .btn:hover {
      transform: translateY(-1px);
      box-shadow: 0 14px 34px rgba(0,0,0,.12);
      background: rgba(255,255,255,.96);
    }

    .btn.primary {
      color: #fff;
      background: linear-gradient(180deg, #1790ff, #007aff);
    }

    .btn.danger {
      color: #fff;
      background: linear-gradient(180deg, #ff6b63, #ff3b30);
    }

    .field {
      margin-bottom: 12px;
    }

    label {
      display: block;
      color: var(--sub);
      font-size: 13px;
      font-weight: 760;
      margin-bottom: 7px;
    }

    .input,
    .textarea {
      width: 100%;
      outline: none;
      border: 1px solid rgba(255,255,255,.84);
      border-radius: 15px;
      padding: 12px 14px;
      background: rgba(255,255,255,.76);
      transition: box-shadow .2s ease, border-color .2s ease;
    }

    .textarea {
      min-height: 82px;
      resize: vertical;
    }

    #detailInput {
      min-height: 130px;
    }

    .input:focus,
    .textarea:focus {
      border-color: rgba(0,122,255,.45);
      box-shadow: 0 0 0 4px rgba(0,122,255,.12);
    }

    .icon-row {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .icon-preview,
    .list-icon {
      width: 44px;
      height: 44px;
      border-radius: 14px;
      object-fit: cover;
      background: #fff;
      border: 1px solid rgba(0,0,0,.06);
    }

    .detail-preview {
      width: 104px;
      height: 68px;
      border-radius: 16px;
      object-fit: cover;
      background: linear-gradient(135deg, rgba(255,255,255,.9), rgba(235,242,250,.9));
      border: 1px solid rgba(0,0,0,.06);
      box-shadow: 0 10px 24px rgba(0,0,0,.08);
    }

    .marker-list {
      max-height: 236px;
      overflow: auto;
      display: flex;
      flex-direction: column;
      gap: 9px;
    }

    .marker-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px;
      border-radius: 17px;
      background: rgba(255,255,255,.66);
      border: 1px solid rgba(255,255,255,.76);
      cursor: pointer;
      transition: transform .2s ease, background .2s ease;
    }

    .marker-item:hover {
      transform: translateY(-1px);
      background: rgba(255,255,255,.9);
    }

    .marker-item.active {
      outline: 3px solid rgba(0,122,255,.16);
      background: rgba(245,250,255,.96);
    }

    .list-meta {
      min-width: 0;
      flex: 1;
    }

    .list-title {
      font-size: 14px;
      font-weight: 820;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .list-desc {
      margin-top: 3px;
      color: var(--sub);
      font-size: 12px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .workspace {
      position: relative;
      border-radius: var(--radius);
      overflow: hidden;
      padding: 14px;
    }

    .map-wrap {
      position: relative;
      width: 100%;
      height: 100%;
      border-radius: 24px;
      overflow: hidden;
      background: linear-gradient(135deg, rgba(255,255,255,.72), rgba(255,255,255,.34));
      border: 1px solid rgba(255,255,255,.72);
    }

    .topbar {
      position: absolute;
      z-index: 30;
      top: 16px;
      left: 16px;
      right: 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      padding: 12px;
      border-radius: 19px;
      background: rgba(255,255,255,.42);
      border: 1px solid rgba(255,255,255,.62);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
    }

    .badges {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .badge {
      border-radius: 999px;
      background: rgba(255,255,255,.78);
      border: 1px solid rgba(255,255,255,.86);
      padding: 8px 12px;
      color: var(--sub);
      font-size: 13px;
    }

    .mini-group {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .mini {
      border: none;
      border-radius: 12px;
      background: rgba(255,255,255,.82);
      padding: 9px 12px;
      cursor: pointer;
      font-weight: 850;
      transition: background .2s ease, transform .2s ease;
    }

    .mini:hover {
      background: #fff;
      transform: translateY(-1px);
    }

    .map-shell {
      position: absolute;
      inset: 0;
      overflow: hidden;
      cursor: grab;
      user-select: none;
    }

    .map-shell.grabbing {
      cursor: grabbing;
    }

    .map-stage {
      position: absolute;
      left: 50%;
      top: 50%;
      transform-origin: 0 0;
      will-change: transform;
    }

    .map-img {
      display: block;
      width: 1200px;
      max-width: none;
      pointer-events: none;
      border-radius: 18px;
      box-shadow: 0 22px 55px rgba(0,0,0,.13);
    }

    .marker-layer {
      position: absolute;
      inset: 0;
    }

    .marker {
      position: absolute;
      width: 58px;
      transform: translate(-50%, -100%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      cursor: pointer;
      z-index: 5;
      animation: markerDrop .48s cubic-bezier(.18, .95, .32, 1.25) both;
    }

    .marker::before {
      content: "";
      position: absolute;
      top: 9px;
      width: 50px;
      height: 50px;
      border-radius: 18px;
      background: rgba(0,122,255,.22);
      filter: blur(4px);
      transform: scale(.9);
      animation: markerPulse 2.2s ease-in-out infinite;
      z-index: -1;
    }

    .marker-icon {
      width: 48px;
      height: 48px;
      border-radius: 16px;
      overflow: hidden;
      border: 2px solid rgba(255,255,255,.92);
      background: #fff;
      box-shadow: 0 12px 28px rgba(0,0,0,.2);
      transition: transform .26s cubic-bezier(.2, 1.4, .35, 1), box-shadow .26s ease;
    }

    .marker:hover .marker-icon {
      transform: translateY(-3px) scale(1.08);
      box-shadow: 0 18px 34px rgba(0,0,0,.24);
    }

    .marker.active .marker-icon {
      transform: translateY(-5px) scale(1.14);
      outline: 4px solid rgba(0,122,255,.22);
    }

    .marker-icon img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .marker-dot {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: var(--blue);
      box-shadow: 0 0 0 5px rgba(0,122,255,.18);
      margin-top: -2px;
    }

    .marker-label {
      max-width: 132px;
      padding: 6px 10px;
      border-radius: 999px;
      background: rgba(255,255,255,.88);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      box-shadow: 0 10px 24px rgba(0,0,0,.12);
      font-size: 12px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      transform: translateY(-1px);
    }

    .popover {
      position: absolute;
      z-index: 40;
      width: min(330px, calc(100% - 40px));
      display: none;
      padding: 15px;
      border-radius: 20px;
      background: rgba(255,255,255,.78);
      border: 1px solid rgba(255,255,255,.78);
      box-shadow: 0 24px 60px rgba(0,0,0,.17);
      backdrop-filter: blur(22px) saturate(180%);
      -webkit-backdrop-filter: blur(22px) saturate(180%);
      transform-origin: center bottom;
    }

    .popover.show {
      display: block;
      animation: popoverIn .36s cubic-bezier(.16, 1.08, .38, 1) both;
    }

    .popover-top {
      display: flex;
      gap: 12px;
      align-items: center;
      margin-bottom: 10px;
    }

    .popover img {
      width: 48px;
      height: 48px;
      border-radius: 15px;
      object-fit: cover;
      box-shadow: 0 10px 24px rgba(0,0,0,.12);
    }

    .popover h4 {
      margin: 0;
      font-size: 17px;
    }

    .popover p {
      margin: 0;
      color: var(--sub);
      font-size: 13px;
      line-height: 1.7;
      white-space: pre-wrap;
    }

    .detail-btn {
      margin-top: 12px;
      width: 100%;
      border: none;
      border-radius: 14px;
      padding: 11px 14px;
      cursor: pointer;
      color: #fff;
      font-weight: 820;
      background: linear-gradient(180deg, #1790ff, #007aff);
      box-shadow: 0 12px 28px rgba(0,122,255,.22);
      transition: transform .22s ease, box-shadow .22s ease;
    }

    .detail-btn:hover {
      transform: translateY(-1px);
      box-shadow: 0 16px 34px rgba(0,122,255,.28);
    }

    .empty {
      color: var(--sub);
      font-size: 13px;
      line-height: 1.7;
    }

    .hidden {
      display: none !important;
    }

    .modal,
    .detail-modal {
      position: fixed;
      inset: 0;
      z-index: 100;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
      background: rgba(15,20,28,.42);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
    }

    .modal.show,
    .detail-modal.show {
      display: flex;
      animation: detailFadeIn .25s ease both;
    }

    .crop-card {
      width: min(720px, 100%);
      border-radius: 28px;
      padding: 18px;
      background: rgba(255,255,255,.8);
      border: 1px solid rgba(255,255,255,.84);
      backdrop-filter: blur(26px);
      -webkit-backdrop-filter: blur(26px);
      box-shadow: 0 30px 90px rgba(0,0,0,.24);
    }

    .crop-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 14px;
    }

    .crop-head h3 {
      margin-bottom: 4px;
    }

    .crop-box {
      display: grid;
      place-items: center;
      padding: 14px;
      border-radius: 22px;
      background: rgba(245,247,250,.88);
      border: 1px solid rgba(255,255,255,.86);
    }

    #cropCanvas {
      width: 360px;
      height: 360px;
      max-width: 100%;
      border-radius: 22px;
      background: #f5f5f7;
      cursor: move;
    }

    .crop-tools {
      margin-top: 14px;
      display: flex;
      gap: 10px;
      align-items: center;
      flex-wrap: wrap;
      justify-content: space-between;
    }

    .range-row {
      display: flex;
      align-items: center;
      gap: 10px;
      flex: 1;
      min-width: 220px;
    }

    input[type="range"] {
      width: 100%;
      accent-color: var(--blue);
    }

    .detail-modal {
      z-index: 120;
      padding: 24px;
      background: rgba(12, 18, 28, .46);
    }

    .detail-card {
      position: relative;
      width: min(980px, 100%);
      max-height: 90vh;
      overflow: auto;
      border-radius: 30px;
      background: rgba(255,255,255,.84);
      border: 1px solid rgba(255,255,255,.84);
      box-shadow: 0 34px 100px rgba(0,0,0,.28);
      backdrop-filter: blur(28px) saturate(180%);
      -webkit-backdrop-filter: blur(28px) saturate(180%);
      animation: detailCardIn .42s cubic-bezier(.16, 1.08, .38, 1) both;
    }

    .detail-close {
      position: absolute;
      top: 16px;
      right: 16px;
      z-index: 3;
      width: 42px;
      height: 42px;
      border: none;
      border-radius: 50%;
      cursor: pointer;
      font-size: 28px;
      line-height: 1;
      color: #1d1d1f;
      background: rgba(255,255,255,.8);
      box-shadow: 0 10px 26px rgba(0,0,0,.12);
    }

    .detail-image-wrap {
      width: 100%;
      min-height: 280px;
      max-height: 58vh;
      overflow: hidden;
      background: linear-gradient(135deg, #eef3f8, #dfe8f4);
      display: grid;
      place-items: center;
    }

    .detail-image-wrap img {
      width: 100%;
      height: 100%;
      max-height: 58vh;
      object-fit: contain;
      display: block;
    }

    .detail-content {
      padding: 26px 30px 32px;
    }

    .detail-kicker {
      color: #007aff;
      font-size: 13px;
      font-weight: 850;
      letter-spacing: .08em;
      margin-bottom: 8px;
    }

    .detail-content h2 {
      margin: 0 0 14px;
      font-size: clamp(26px, 4vw, 42px);
      letter-spacing: -1px;
    }

    .detail-content p {
      margin: 0;
      color: #424245;
      font-size: 16px;
      line-height: 1.9;
      white-space: pre-wrap;
    }

    @keyframes markerDrop {
      0% {
        opacity: 0;
        transform: translate(-50%, -120%) scale(.68);
        filter: blur(4px);
      }
      70% {
        opacity: 1;
        transform: translate(-50%, -96%) scale(1.08);
        filter: blur(0);
      }
      100% {
        opacity: 1;
        transform: translate(-50%, -100%) scale(1);
      }
    }

    @keyframes markerPulse {
      0%, 100% {
        opacity: .34;
        transform: scale(.82);
      }
      50% {
        opacity: .68;
        transform: scale(1.12);
      }
    }

    @keyframes popoverIn {
      0% {
        opacity: 0;
        transform: translateY(14px) scale(.9);
        filter: blur(5px);
      }
      75% {
        opacity: 1;
        transform: translateY(-2px) scale(1.02);
        filter: blur(0);
      }
      100% {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    @keyframes detailFadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes detailCardIn {
      0% {
        opacity: 0;
        transform: translateY(22px) scale(.94);
        filter: blur(6px);
      }
      75% {
        opacity: 1;
        transform: translateY(-2px) scale(1.015);
        filter: blur(0);
      }
      100% {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    @media (max-width: 1050px) {
      .app {
        grid-template-columns: 1fr;
        grid-template-rows: auto 1fr;
      }

      .sidebar {
        max-height: 43vh;
      }
    }

    @media (max-width: 640px) {
      .app {
        padding: 10px;
        gap: 10px;
      }

      .sidebar,
      .workspace {
        border-radius: 22px;
      }

      .brand h1 {
        font-size: 24px;
      }

      .topbar {
        align-items: flex-start;
        flex-direction: column;
      }

      .map-img {
        width: 1000px;
      }

      .detail-modal {
        padding: 12px;
      }

      .detail-content {
        padding: 22px 20px 26px;
      }

      .detail-image-wrap {
        min-height: 220px;
      }
    }
  </style>
</head>

<body>
  <div class="app">
    <aside class="sidebar glass">
      <section class="card brand">
        <h1>河中观花指南</h1>
        <p>校园观花地图指南。支持花点标注、高清图片展示、详细文字介绍、自定义图标与本地保存。</p>
      </section>

      <section class="card">
        <h3>地图操作</h3>
        <div class="btn-grid">
          <button class="btn primary" id="addModeBtn">开启添加花点</button>
          <button class="btn" id="resetBtn">重置视图</button>
          <button class="btn" id="exportBtn">导出花点</button>
          <button class="btn" id="importBtn">导入花点</button>
          <button class="btn" id="restoreBtn">恢复内置</button>
          <button class="btn danger" id="clearBtn">清空本地</button>
        </div>
        <p class="hint">首次打开会显示内置花点。编辑后数据会保存在当前浏览器本地。</p>
        <input class="hidden" id="importInput" type="file" accept=".json" />
      </section>

      <section class="card">
        <h3>花点编辑</h3>

        <div class="field">
          <label>花点名称</label>
          <input class="input" id="titleInput" placeholder="例如：凤凰花" />
        </div>

        <div class="field">
          <label>简短说明</label>
          <textarea class="textarea" id="descInput" placeholder="用于地图小卡片展示"></textarea>
        </div>

        <div class="field">
          <label>详细文字描述</label>
          <textarea class="textarea" id="detailInput" placeholder="填写花卉介绍、观赏季节、位置说明、拍照建议等"></textarea>
        </div>

        <div class="field">
          <label>标点图标</label>
          <div class="icon-row">
            <img class="icon-preview" id="iconPreview" alt="图标预览" />
            <button class="btn" id="uploadBtn">上传并裁剪</button>
            <input class="hidden" id="iconInput" type="file" accept="image/*" />
          </div>
        </div>

        <div class="field">
          <label>高清完整图片</label>
          <div class="icon-row">
            <img class="detail-preview" id="detailImagePreview" alt="高清图片预览" />
            <button class="btn" id="uploadDetailImageBtn">上传高清图片</button>
            <input class="hidden" id="detailImageInput" type="file" accept="image/*" />
          </div>
          <p class="hint">此图片不裁剪，点击详情时完整展示。</p>
        </div>

        <div class="btn-grid">
          <button class="btn primary" id="saveBtn">保存修改</button>
          <button class="btn danger" id="deleteBtn">删除花点</button>
        </div>
      </section>

      <section class="card">
        <h3>花点列表</h3>
        <div class="marker-list" id="markerList"></div>
        <div class="empty" id="emptyTip">暂无花点。请先开启添加模式并点击地图。</div>
      </section>
    </aside>

    <main class="workspace glass">
      <div class="map-wrap">
        <div class="topbar">
          <div class="badges">
            <div class="badge">河中观花指南</div>
            <div class="badge" id="modeBadge">模式：浏览</div>
          </div>
          <div class="mini-group">
            <button class="mini" id="zoomOutBtn">－</button>
            <button class="mini" id="zoomInBtn">＋</button>
            <button class="mini" id="fitBtn">适应窗口</button>
          </div>
        </div>

        <div class="map-shell" id="mapShell">
          <div class="map-stage" id="mapStage">
            <img class="map-img" id="mapImg" src="./ditu.png" alt="河中地图" />
            <div class="marker-layer" id="markerLayer"></div>
          </div>
        </div>

        <div class="popover" id="popover">
          <div class="popover-top">
            <img id="popIcon" alt="" />
            <div>
              <h4 id="popTitle">花点名称</h4>
            </div>
          </div>
          <p id="popDesc">花点说明</p>
          <button class="detail-btn" id="openDetailBtn">查看详情</button>
        </div>
      </div>
    </main>
  </div>

  <div class="modal" id="cropModal">
    <div class="crop-card">
      <div class="crop-head">
        <div>
          <h3>裁剪标点图标</h3>
          <div class="hint">拖动画布调整位置，使用滑块缩放图片。裁剪结果为正方形。</div>
