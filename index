    const DEFAULT_DETAIL_IMAGE = svgDetailImage("暂无高清图片", "#F5FAFF", "#DCEBFA", "#8cc8ff");

    const DEFAULT_MARKERS = [
      {
        id: "flower_gate",
        x: 640,
        y: 755,
        title: "校门迎春花",
        desc: "校门附近的春日花点，适合入校第一站打卡。",
        detail:
          "校门迎春花位于学校正门附近，是进入校园后较容易看到的观花点。\n\n观赏建议：\n1. 上午光线柔和，适合拍摄校门与花景合影。\n2. 可从正门广场向教学楼方向取景，画面层次更丰富。\n3. 花期可根据当年气候略有变化，建议春季重点关注。",
        icon: flowerIcon("#ffcf33"),
